#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
DIST="$ROOT/engine/vendor/nerolis-lab/common/dist/index.mjs"
if [ ! -f "$DIST" ]; then
  echo "Neroli’s Lab common is not built. Run: cd engine/vendor/nerolis-lab/common && npm run build" >&2
  exit 2
fi
exec node "$ROOT/engine/src/cli.mjs"
